<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bhaskara.MainPage"
             Title="Bhaskara">

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="30">
            <Image Source="bhaskaraf.png" Aspect="Center"/>

            <Label Text="Digite os valores:"/>
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center" >
                <Label Text="a: " VerticalOptions="Center"/>
                <Entry x:Name="valueA" Placeholder="A" Keyboard="Numeric"/>
                <Label Text="b: " VerticalOptions="Center"/>
                <Entry x:Name="valueB" Placeholder="B" Keyboard="Numeric"/>
                <Label Text="c: " VerticalOptions="Center"/>
                <Entry x:Name="valueC" Placeholder="C" Keyboard="Numeric"/>
            </HorizontalStackLayout>

            <Button x:Name="btCalcularRaizes" Text="Calcular Raízes" HorizontalOptions="Fill" Clicked="btCalcularRaizes_Clicked" BackgroundColor="Black"/>

            <Label x:Name="lbResultado" Text=" " FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
